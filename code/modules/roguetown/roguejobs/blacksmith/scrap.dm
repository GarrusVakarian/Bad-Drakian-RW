/obj/item/roguestatue/decrepit/scrap/Initialize(mapload)
	. = ..()
	icon_state = "scrap_astatue[pick(1,2)]"

/obj/item/rogueweapon/tongs/ancient/decrepit/scrap/update_icon()
	. = ..()
	if(!hingot)
		icon_state = "scrap_atongs"
	else
		if(hott)
			icon_state = "scrap_atongsi1"
		else
			icon_state = "scrap_atongsi0"

/obj/item/clothing/wrists/roguetown/bracers/chain/ancient/decrepit/scrap/attack_right(mob/user)
	. = ..()
	// Our parent flips between the decrepit sprites, so swap in the scrap ones.
	if(wrapped)
		icon_state = "scrap_ancientchainsleeves"
	else
		icon_state = initial(icon_state)
	item_state = icon_state
	user.update_inv_wrists()

// SLAG KILN

/obj/machinery/light/rogue/smelter/slag_kiln
	name = "slag kiln"
	desc = "A squat, soot-blackened kiln built for one ugly job: cooking rock and coal down into scrap slag."
	icon_state = "slagkiln0"
	base_state = "slagkiln"
	max_contained_items = 12
	smelting_ticks = 40
	climbable = FALSE
	/// Once a batch has cooked, the kiln's belly is molten, and any rock or coal fed to it slumps straight into slag.
	var/molten = FALSE
	/// Smelting quality of each lump of slag in the heap, waiting to be hammered loose.
	var/list/slag_heap = list()
	/// The most slag that can pile up inside before it has to be broken out.
	var/max_slag = 30

/obj/machinery/light/rogue/smelter/slag_kiln/examine(mob/user, params)
	. = ..()
	. += span_info("Fill it with rocks and at least one coal for every [SCRAP_ROCKS_PER_FLUX] rocks, then light it. Once its belly runs molten, any rock or coal fed to it turns straight to slag.")
	. += span_info("Break the slag loose with a hammer.")
	if(molten)
		. += span_warning("Its belly glows with molten slag.")
	if(length(slag_heap))
		. += span_notice("There [length(slag_heap) == 1 ? "is a lump" : "are [length(slag_heap)] lumps"] of slag waiting to be broken out.")

/obj/machinery/light/rogue/smelter/slag_kiln/attackby(obj/item/attacking_item, mob/living/user, params)
	if(istype(attacking_item, /obj/item/rogueweapon/hammer))
		break_slag(user)
		return
	if(is_scrap_rock(attacking_item))
		add_item(attacking_item, user)
		return
	return ..()

/obj/machinery/light/rogue/smelter/slag_kiln/attack_right(mob/user)
	var/obj/item/held_item = user.get_active_held_item()
	if(is_scrap_rock(held_item) || istype(held_item, /obj/item/rogueore/coal))
		add_item(held_item, user)
		return
	return ..()

/obj/machinery/light/rogue/smelter/slag_kiln/add_item(obj/item/smelting_item, mob/user)
	if(!smelting_item)
		return FALSE
	if(!is_scrap_rock(smelting_item) && !istype(smelting_item, /obj/item/rogueore/coal))
		to_chat(user, span_warning("\The [src] only takes rocks and coal."))
		return FALSE
	if(length(slag_heap) + length(contained_items) >= max_slag)
		to_chat(user, span_warning("\The [src] is choked with slag. Break some of it loose first."))
		return FALSE
	if(!molten)
		return ..()
	if(!on)
		to_chat(user, span_warning("\The [src] has gone cold."))
		return FALSE
	user.dropItemToGround(smelting_item)
	user.visible_message(span_notice("[user] feeds [smelting_item] into \the [src], and it slumps into the molten slag."))
	slag_heap += roll_smelt_quality(user)
	qdel(smelting_item)
	playsound(src, 'sound/misc/smelter_sound.ogg', 50, FALSE)
	return TRUE

/obj/machinery/light/rogue/smelter/slag_kiln/handle_smelting()
	var/rocks = 0
	var/coal = 0
	for(var/obj/item/item as anything in contained_items)
		if(istype(item, /obj/item/rogueore/coal))
			coal++
		else
			rocks++

	if(!rocks || coal * SCRAP_ROCKS_PER_FLUX < rocks)
		visible_message(span_warning("The rocks in \the [src] crack and blacken, but there isn't enough coal to melt them down."))
	else
		for(var/obj/item/item as anything in contained_items)
			slag_heap += contained_items[item]
			qdel(item)
		contained_items.Cut()
		molten = TRUE
		update_icon()
		visible_message(span_notice("The belly of \the [src] slumps into a glowing, molten mass of slag."))
		playsound(src, 'sound/misc/smelter_fin.ogg', 100, FALSE)

	smelting_progress = smelting_ticks + 1
	actively_smelting = FALSE

/obj/machinery/light/rogue/smelter/slag_kiln/burn_out()
	if(molten)
		molten = FALSE
		visible_message(span_notice("The slag in \the [src] dulls and hardens as it cools."))
	return ..()

/obj/machinery/light/rogue/smelter/slag_kiln/update_icon()
	if(on && molten)
		icon_state = "[base_state]molten1"
		return
	return ..()

/// Hammers lumps of slag loose from the heap, one at a time, until it's empty or [user] stops.
/obj/machinery/light/rogue/smelter/slag_kiln/proc/break_slag(mob/living/user)
	if(!length(slag_heap))
		to_chat(user, span_warning("There's no slag in \the [src] to break loose."))
		return
	user.visible_message(span_info("[user] starts hammering at the slag in \the [src]."), span_info("I start hammering at the slag in \the [src]."))
	while(length(slag_heap))
		playsound(src, pick('sound/items/bsmith1.ogg','sound/items/bsmith2.ogg','sound/items/bsmith3.ogg','sound/items/bsmith4.ogg'), 100, FALSE)
		if(!do_after(user, 3 SECONDS, target = src))
			return
		if(!length(slag_heap) || !istype(user.get_active_held_item(), /obj/item/rogueweapon/hammer))
			return
		var/quality = slag_heap[length(slag_heap)]
		slag_heap.len--
		new /obj/item/ingot/scrap(get_turf(user), quality)
		user.visible_message(span_info("[user] breaks a lump of slag loose from \the [src]."))
